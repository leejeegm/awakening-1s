# Supabase (자깨초시 실험 데이터)
# https://supabase.com/dashboard 프로젝트 설정에서 복사하세요.
NEXT_PUBLIC_SUPABASE_URL=https://lxvuyhiflpdyeegjrsva.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 기능 (기록 삭제/수정). 서비스 역할 키는 Dashboard → Settings → API → service_role (비공개 유지).
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 전용 비밀번호. /admin 접속 시 이 비밀번호로 로그인 후 삭제/수정 가능.
ADMIN_SECRET="s*****오****"

# Gemini (권장): 따뜻한 한마디·인사이트 카드·주간 요약은 1차로 Gemini 호출.
# GEMINI_API_KEY=... 를 쓰거나 아래처럼 별칭 변수도 가능합니다.
# GEMINI_JAKKAE_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI GPT-4o (선택·정밀): ① 1초 찰나(1s) 컨텍스트가 있는 요청만 텍스트 보강
#    ② 공개 기록 검수: Gemini 불가 시 폴백, 또는 Gemini가 warn일 때 1s 공개만 재판정
# 발급: https://platform.openai.com/api-keys → Create new secret key
# OPENAI_API_KEY=sk-proj-...

# 모더레이션 삭제(보관) 건 완전 폐기까지 최소 보관 일수 (기본 30). 7·30·90 등으로 조정 가능.
# MODERATION_QUARANTINE_DAYS=30

# 서버 이미지/웹툰 생성 (승인 사용자 전용). SD WebUI 등 txt2img 엔드포인트 URL (서버에서 접근 가능한 주소).
# IMAGE_ENGINE_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
# Supabase Storage 버킷 이름 (대시보드에서 생성 권장). 기본 generated
# IMAGE_BUCKET=generated
# 닉네임별 한도 (선택). 미설정 시 기본: 일 10회, 월 50회(bun/si 플랜은 월 280)
# IMAGE_DAILY_LIMIT=10
# IMAGE_MONTHLY_LIMIT_DEFAULT=50
# IMAGE_MONTHLY_LIMIT_BUN=280
# IMAGE_MONTHLY_LIMIT_SI=280

# 참고: 실명/전화번호 수집 없이 닉네임·한줄 기록만 저장합니다.
